# Public / deploy-time configuration
# Leave values empty here. Inject real values in the hosting environment.
# Never commit secrets or local service URLs.

# --- apps/api (runtime, server-only) ---
# Listen address uses 0.0.0.0 and PORT (default 3000 when unset at runtime).
PORT=
# Comma-separated exact origins for credentialed CORS. No wildcards.
CORS_ORIGIN=
# Alias accepted by the API when CORS_ORIGIN is unset (same format).
ALLOWED_ORIGINS=
# GROQ inference credential. Required for live chat; never inlined in source.
GROQ_API_KEY=
# Platform-managed public origin of this deployment (no trailing slash).
REPOFIXER_SELF_URL=
PUBLIC_URL=

# --- apps/ai-chat (Vite, compile-time public) ---
# Exact API origin baked into the static bundle. No localhost fallback.
VITE_API_ORIGIN=
